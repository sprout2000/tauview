{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauview",
  "version": "0.1.1",
  "identifier": "jp.sprout2000.Tauview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: tauview: http://tauview.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Tauview",
        "theme": "Dark",
        "resizable": true,
        "fullscreen": false,
        "width": 800,
        "height": 560,
        "minWidth": 800,
        "minHeight": 560
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg"],
        "name": "JPEG Image",
        "description": "JPEG Image",
        "mimeType": "image/jpeg",
        "role": "Viewer"
      },
      {
        "ext": ["png"],
        "name": "PNG Image",
        "description": "PNG Image",
        "mimeType": "image/png",
        "role": "Viewer"
      },
      {
        "ext": ["gif"],
        "name": "GIF Image",
        "description": "GIF Image",
        "mimeType": "image/gif",
        "role": "Viewer"
      },
      {
        "ext": ["webp"],
        "name": "WebP Image",
        "description": "WebP Image",
        "mimeType": "image/webp",
        "role": "Viewer"
      },
      {
        "ext": ["bmp"],
        "name": "BMP Image",
        "description": "BMP Image",
        "mimeType": "image/bmp",
        "role": "Viewer"
      },
      {
        "ext": ["ico"],
        "name": "ICO Image",
        "description": "ICO Image",
        "mimeType": "image/vnd.microsoft.icon",
        "role": "Viewer"
      },
      {
        "ext": ["svg"],
        "name": "SVG Image",
        "description": "SVG Image",
        "mimeType": "image/svg+xml",
        "role": "Viewer"
      }
    ]
  }
}

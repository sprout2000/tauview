{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "jp.sprout2000.Tauview",
  "bundle": {
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg"],
        "name": "JPEG Image",
        "mimeType": "image/jpeg",
        "role": "Viewer"
      },
      {
        "ext": ["png"],
        "name": "PNG Image",
        "mimeType": "image/png",
        "role": "Viewer"
      },
      {
        "ext": ["gif"],
        "name": "GIF Image",
        "mimeType": "image/gif",
        "role": "Viewer"
      },
      {
        "ext": ["webp"],
        "name": "WebP Image",
        "mimeType": "image/webp",
        "role": "Viewer"
      },
      {
        "ext": ["bmp"],
        "name": "BMP Image",
        "mimeType": "image/bmp",
        "role": "Viewer"
      },
      {
        "ext": ["ico"],
        "name": "ICO Image",
        "mimeType": "image/vnd.microsoft.icon",
        "role": "Viewer"
      },
      {
        "ext": ["svg"],
        "name": "SVG Image",
        "mimeType": "image/svg+xml",
        "role": "Viewer"
      },
      {
        "ext": ["heic"],
        "name": "HEIC Image",
        "mimeType": "image/heic",
        "role": "Viewer"
      },
      {
